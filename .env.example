# Copy to .env (gitignored). Never commit real values.

# --- Modelo ---------------------------------------------------------------------------
# Sin ANTHROPIC_API_KEY se usa `claude -p` con la cuenta logueada de Claude Code (plan B).
ANTHROPIC_API_KEY=
DIGEST_MODEL=claude-sonnet-5-5
# auto | anthropic | claude-cli
DIGEST_LLM_BACKEND=auto
# Opcional, solo para estimar costo con la API (USD por millón de tokens). `claude -p` informa el costo real.
DIGEST_PRICE_INPUT_PER_MTOK=
DIGEST_PRICE_OUTPUT_PER_MTOK=
# Opcional: ruta al claude.exe nativo si no se resuelve solo (Windows/npm)
DIGEST_CLAUDE_EXE=

# --- Informe --------------------------------------------------------------------------
# Nombres con los que aparecés en mails/chats, separados por |. Si falta, se toma de Jira (/myself).
DIGEST_OWNER=
# 1 = los eventos que cubren toda la jornada (09-18) bloquean el plan. Por defecto son informativos.
DIGEST_ALLDAY_BLOQUEA=

# --- Jira Cloud -----------------------------------------------------------------------
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Microsoft 365 --------------------------------------------------------------------
# Token corto (~1 h) de Graph Explorer con Calendars.Read, Mail.Read y Chat.Read.
# Si falta, --fuentes-m365 auto usa el conector Microsoft 365 vía `claude -p` (plan B).
GRAPH_ACCESS_TOKEN=
GRAPH_TIMEZONE=Argentina Standard Time
DIGEST_TZ=America/Argentina/Buenos_Aires
DIGEST_M365_MCP_SERVER=claude_ai_Microsoft_365
